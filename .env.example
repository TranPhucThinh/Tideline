# Copy this file to `.env` and fill in your Supabase project credentials.
# Get them from your Supabase project: Project Settings > API
#   Project URL -> e.g. https://abcdefghijklm.supabase.co
#   anon public key -> the "anon" publishable API key (JWT)

PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"